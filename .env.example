# ==============================================================================
# Relay AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for backend/local runtime or web/.env.local for Next.js.
# Do NOT commit production keys or sensitive secrets to version control.
# ==============================================================================

# --- AI Provider API Keys ---
# Groq Cloud (Ultra-low latency inference via LPU)
GROQ_API_KEY=your_groq_api_key_here

# Google Developer API (Gemini 2.5/3.5 models)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (GPT-4o, GPT-4o-mini, o3)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter (Optional multi-model aggregator)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local Ollama Inference (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# --- Supabase Cloud Context & Authentication ---
# Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public / Anon Key (Safe for client-side web application)
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here

# Supabase Service Role Key (Backend server-side only; never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Server & Web Configuration ---
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key_here
